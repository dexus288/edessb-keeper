[Unit]
Description=EDESSB gateway (authenticated reverse proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edessb
WorkingDirectory=/opt/edessb-keeper
EnvironmentFile=/opt/edessb-keeper/.env
ExecStart=/opt/edessb-keeper/venv/bin/python /opt/edessb-keeper/gateway.py
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/edessb-keeper

[Install]
WantedBy=multi-user.target
