# --- Обовʼязкові ---
# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=123456:AA...

# --- Рекомендовані ---
# Ваш chat_id (дізнатись: напишіть боту @userinfobot).
# Якщо лишити порожнім — бот привʼяжеться до першого, хто надішле /start.
TELEGRAM_CHAT_ID=

# URL, що вимагає авторизації — ним і пінгуємо, і перевіряємо сесію.
# Вкажіть реальну "кабінетну" сторінку ЄДЕССБ, а не публічну головну.
EDESSB_KEEPALIVE_URL=https://e-construction.gov.ua/

# Інтервал перевірки (секунд). 300 = 5 хв.
CHECK_INTERVAL=300

# --- Необовʼязкові маркери для точнішого визначення стану сесії ---
# Рядок, який присутній ЛИШЕ коли ви залогінені (напр. ваше ПІБ або ЄДРПОУ).
EDESSB_OK_MARKER=
# Рядок, який зʼявляється на сторінці логіну (напр. "Увійти через id.gov.ua").
EDESSB_LOGIN_MARKER=

# Необовʼязково: свій User-Agent (краще взяти такий самий, як у вашому браузері).
# EDESSB_USER_AGENT=

# Таймаут HTTP, секунд.
HTTP_TIMEOUT=30

# Куди складати cookies.txt / state.json (за замовчуванням — поряд зі скриптом).
# EDESSB_DATA_DIR=/opt/edessb-keeper
